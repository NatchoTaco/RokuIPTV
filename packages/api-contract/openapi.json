                "live_tv",
                "movie",
                "series",
                "unknown"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "url": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [

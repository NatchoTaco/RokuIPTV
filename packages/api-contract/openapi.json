          "id",
          "name",
          "source_type",
          "status",
          "status_message",
          "display_location",
          "is_enabled",
          "enabled_content_types",
          "refresh_interval_minutes",
          "last_updated_at",
          "last_refresh_at",
          "next_refresh_at",
          "last_error",
          "channel_count",
          "group_count",
          "active_job"

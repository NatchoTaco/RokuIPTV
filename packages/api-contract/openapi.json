                "movie",
                "series",
                "unknown"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "group_count": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "is_enabled": {
            "type": "boolean"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_refresh_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "last_updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "next_refresh_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "refresh_interval_minutes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "source_type": {
            "enum": [
              "m3u_url",
              "m3u_upload",

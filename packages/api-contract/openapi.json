              }
            },
            "description": "Source list"
          }
        },
        "summary": "List television sources",
        "tags": [
          "sources"
        ]
      }
    },
    "/api/v1/sources/demo": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceCreateDemoRequest"

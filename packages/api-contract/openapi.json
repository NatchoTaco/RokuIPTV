  "components": {
    "schemas": {
      "AuthResponse": {
        "type": "object",
        "required": ["user", "setup"],
        "properties": {
          "user": { "$ref": "#/components/schemas/UserPublic" },
          "setup": { "$ref": "#/components/schemas/SetupStateResponse" }
        }
      },
      "BootstrapAdminRequest": {
        "type": "object",
        "required": ["email", "password", "display_name"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 12, "maxLength": 256 },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      },
      "SignInRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      },
      "UserPublic": {
        "type": "object",
        "required": ["id", "email", "display_name", "is_admin"],
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "display_name": { "type": "string" },
          "is_admin": { "type": "boolean" }
        }
      },
      "SetupStateResponse": {
        "type": "object",
        "required": ["is_complete", "current_step", "completed_steps", "installation_mode", "administrator_exists"],
        "properties": {
          "is_complete": { "type": "boolean" },
          "current_step": { "type": "string" },
          "completed_steps": { "type": "array", "items": { "type": "string" } },
          "installation_mode": { "type": ["string", "null"], "enum": ["local_only", "remote_access", null] },
          "administrator_exists": { "type": "boolean" }
        }
      },
      "SetupStateUpdate": {
        "type": "object",
        "required": ["installation_mode"],
        "properties": {
          "installation_mode": { "type": "string", "enum": ["local_only", "remote_access"] }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status", "service", "version", "environment", "setup_complete", "checks"],
        "properties": {
          "status": { "type": "string" },
          "service": { "type": "string" },
          "version": { "type": "string" },
          "environment": { "type": "string" },
          "setup_complete": { "type": "boolean" },
          "checks": {
            "type": "object",
            "additionalProperties": { "$ref": "#/components/schemas/ServiceCheck" }
          }
        }
      },
      "ServiceCheck": {
        "type": "object",
        "required": ["status", "detail"],
        "properties": {
          "status": { "type": "string" },
          "detail": { "type": "string" }
        }
      },
      "MessageResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" }
        }
      },
      "SourceValidateUrlRequest": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri" }
        }
      },
      "UploadPlaylistRequest": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": { "type": "string", "format": "binary" }
        }
      },
      "CreateUploadSourceRequest": {
        "type": "object",
        "required": ["name", "file"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 180 },
          "refresh_interval_minutes": { "type": ["integer", "null"], "minimum": 15, "maximum": 43200 },
          "file": { "type": "string", "format": "binary" }
        }
      },
      "SourceCreateUrlRequest": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 180 },
          "url": { "type": "string", "format": "uri" },
          "refresh_interval_minutes": { "type": ["integer", "null"], "minimum": 15, "maximum": 43200, "default": 1440 }
        }
      },
      "SourceCreateDemoRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "default": "Synthetic Demonstration Playlist" },
          "refresh_interval_minutes": { "type": ["integer", "null"], "minimum": 15, "maximum": 43200 }
        }
      },
      "SourceUpdateRequest": {
        "type": "object",
        "properties": {
          "is_enabled": { "type": ["boolean", "null"] },
          "refresh_interval_minutes": { "type": ["integer", "null"], "minimum": 15, "maximum": 43200 }
        }
      },
      "SourceValidationResponse": {
        "type": "object",
        "required": ["playlist_reachable", "channel_count", "group_count", "estimated_import_time_seconds", "warnings", "errors", "checksum", "source_version"],
        "properties": {
          "playlist_reachable": { "type": "boolean" },
          "channel_count": { "type": "integer" },
          "group_count": { "type": "integer" },
          "estimated_import_time_seconds": { "type": "integer" },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "errors": { "type": "array", "items": { "type": "string" } },
          "checksum": { "type": ["string", "null"] },
          "source_version": { "type": ["string", "null"] }
        }
      },
      "SourceListResponse": {
        "type": "object",
        "required": ["sources"],
        "properties": {
          "sources": { "type": "array", "items": { "$ref": "#/components/schemas/SourceSummaryResponse" } }
        }
      },
      "SourceCreatedResponse": {
        "type": "object",
        "required": ["source", "job"],
        "properties": {
          "source": { "$ref": "#/components/schemas/SourceSummaryResponse" },
          "job": { "$ref": "#/components/schemas/PlaylistImportJobResponse" }
        }
      },
      "SourceSummaryResponse": {
        "type": "object",
        "required": ["id", "name", "source_type", "status", "status_message", "display_location", "is_enabled", "refresh_interval_minutes", "last_updated_at", "last_refresh_at", "next_refresh_at", "last_error", "channel_count", "group_count", "active_job"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "source_type": { "type": "string", "enum": ["m3u_url", "m3u_upload", "demo_playlist"] },
          "status": { "type": "string", "enum": ["healthy", "importing", "warning", "offline", "failed", "disabled", "pending"] },
          "status_message": { "type": "string" },
          "display_location": { "type": "string" },
          "is_enabled": { "type": "boolean" },
          "refresh_interval_minutes": { "type": ["integer", "null"] },
          "last_updated_at": { "type": "string", "format": "date-time" },
          "last_refresh_at": { "type": ["string", "null"], "format": "date-time" },
          "next_refresh_at": { "type": ["string", "null"], "format": "date-time" },
          "last_error": { "type": ["string", "null"] },
          "channel_count": { "type": "integer" },
          "group_count": { "type": "integer" },
          "active_job": { "anyOf": [{ "$ref": "#/components/schemas/PlaylistImportJobResponse" }, { "type": "null" }] }
        }
      },
      "PlaylistImportJobResponse": {
        "type": "object",
        "required": ["id", "source_id", "playlist_import_id", "status", "progress_percent", "message", "started_at", "completed_at", "failure_reason"],
        "properties": {
          "id": { "type": "string" },
          "source_id": { "type": "string" },
          "playlist_import_id": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["queued", "running", "succeeded", "failed"] },

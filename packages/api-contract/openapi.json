          },
          "name": {
            "maxLength": 180,
            "minLength": 1,
            "type": "string"
          },
          "refresh_interval_minutes": {
            "maximum": 43200,
            "minimum": 15,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "file"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ServiceCheck"

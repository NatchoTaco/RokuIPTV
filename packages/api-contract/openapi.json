        "required": [
          "id",
          "source_id",
          "source_name",
          "source_kind",
          "status",
          "started_at",
          "completed_at",
          "duration_ms",
          "channel_count",
          "group_count",
          "warning_count",
          "failure_count",
          "warnings",
          "failures",
          "failure_reason",
          "checksum",

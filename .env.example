STREAMFORGE_ENV=development
STREAMFORGE_VERSION=0.1.0
STREAMFORGE_SECRET_KEY=change-this-development-secret
STREAMFORGE_DATABASE_URL=postgresql+psycopg://streamforge:streamforge@postgres:5432/streamforge
STREAMFORGE_REDIS_URL=redis://redis:6379/0
STREAMFORGE_CORS_ORIGINS=http://localhost:5173
STREAMFORGE_COOKIE_SECURE=false
STREAMFORGE_SESSION_TTL_MINUTES=10080
STREAMFORGE_SOURCE_UPLOAD_DIR=/app/data/uploads
STREAMFORGE_SOURCE_REQUEST_TIMEOUT_SECONDS=10
STREAMFORGE_SOURCE_MAX_PLAYLIST_BYTES=20000000
STREAMFORGE_SOURCE_WORKER_POLL_SECONDS=2
STREAMFORGE_SOURCE_LARGE_PLAYLIST_WARNING_ENTRIES=100000
STREAMFORGE_SOURCE_IMPORT_CONFIRMATION_THRESHOLD_ENTRIES=50000
STREAMFORGE_SOURCE_IMPORT_BATCH_SIZE=1000
STREAMFORGE_SOURCE_ESTIMATED_ENTRIES_PER_SECOND=250
STREAMFORGE_ALLOW_PRIVATE_SOURCE_URLS=false
POSTGRES_DB=streamforge
POSTGRES_USER=streamforge
POSTGRES_PASSWORD=streamforge
VITE_API_BASE_URL=http://localhost:8000
